# 範例環境設定檔，部署前請複製為 .env 並修改

OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=meguru
MODEL_CONTEXT_TOKENS=4096
CHAT_MAX_OUTPUT_TOKENS=300
CHAT_MAX_PROMPT_TOKENS=3668
CHAT_MAX_USER_TOKENS=768
MEGURU_GGUF_PATH=tools/model_training/meguru_q4_k_m.gguf
MEGURU_TOKENIZER_MODE=auto
RAG_ENABLED=false
CONTEXT_BUDGET_MANIFEST_PATH=data/context_budget_manifest.json
RAG_CHROMA_PATH=data/knowledge/chroma
RAG_COLLECTION=meguru_knowledge
RAG_CORPUS_PATH=data/knowledge/examples
RAG_GATE_INVENTORY_PATH=data/knowledge/gate_inventory.json
# Local checkout of intfloat/multilingual-e5-small; runtime does not download it.
RAG_EMBEDDING_MODEL_PATH=models/embeddings/multilingual-e5-small
RAG_MAX_RESULTS=3
RAG_MIN_SIMILARITY=0.70
# Preferred tie-break scope only; all route scopes remain searchable.
RAG_ROUTE_SCOPE=meguru
RAG_CHUNK_TARGET_CHARS=700
RAG_CHUNK_OVERLAP_CHARS=80
CONTEXT_DIAGNOSTICS=false
TTS_BACKEND=voicevox
VOICEVOX_ENDPOINT=http://127.0.0.1:50021
LIPSYNC_ENABLED=false
VC_ENABLED=false
API_PORT=5000
OVERLAY_PORT=3322
